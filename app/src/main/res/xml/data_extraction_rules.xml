<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Android 12+: invoice data and private company logos stay out of cloud backup. -->
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <!-- Preserve Android's existing direct device-to-device migration behavior. -->
</data-extraction-rules>
