<?xml version="1.0" encoding="utf-8"?>
<!-- Android 6-11: keep invoice records, legacy preferences, and company logos
     out of Android Auto Backup. Explicit PDF/CSV sharing remains available. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
